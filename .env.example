# =============================================================================
# LastDonor - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Required vars are marked [REQUIRED], optional ones [OPTIONAL].
# =============================================================================

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string (Supabase, Neon, or local)
DATABASE_URL=postgresql://user:password@localhost:5432/lastdonor

# ── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# [REQUIRED] Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# [REQUIRED] App base URL (http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000

# [OPTIONAL] Google OAuth (for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe (Payments) ───────────────────────────────────────────────────────
# [REQUIRED] Stripe secret key (sk_test_...)
STRIPE_SECRET_KEY=
# [REQUIRED] Publishable key - exposed to browser (pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# [REQUIRED] Webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# [OPTIONAL] Connect webhook secret - for Stripe Connect payouts
STRIPE_CONNECT_WEBHOOK_SECRET=

# ── Supabase (File Storage) ─────────────────────────────────────────────────
# [REQUIRED] Supabase project URL
SUPABASE_URL=
# [REQUIRED] Supabase service role key (NOT the anon key)
SUPABASE_SERVICE_ROLE_KEY=
# [REQUIRED] Public URL for browser Supabase client (Realtime)
NEXT_PUBLIC_SUPABASE_URL=
# [REQUIRED] Supabase anon key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# [REQUIRED] Resend API key for transactional emails
RESEND_API_KEY=
# [OPTIONAL] Secret for newsletter unsubscribe link signing
NEWSLETTER_UNSUBSCRIBE_SECRET=

# ── Sentry (Error Tracking) ─────────────────────────────────────────────────
# [OPTIONAL] Sentry DSN - server-side
SENTRY_DSN=
# [OPTIONAL] Sentry DSN - client-side (browser)
NEXT_PUBLIC_SENTRY_DSN=
# [OPTIONAL] Sentry org/project for source maps upload
SENTRY_ORG=
SENTRY_PROJECT=

# ── AI / OpenRouter ─────────────────────────────────────────────────────────
# [OPTIONAL] OpenRouter API key for blog generation
OPENROUTER_API_KEY=
# [OPTIONAL] Fallback key if primary runs out of credits
OPENROUTER_API_KEY_FALLBACK=

# ── Image Generation (Free Stock Photos) ────────────────────────────────────
# [OPTIONAL] Unsplash API (primary) - https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# [OPTIONAL] Pexels API (fallback) - https://www.pexels.com/api/
PEXELS_API_KEY=


# ── News API ─────────────────────────────────────────────────────────────────
# [OPTIONAL] GNews API key for news-to-blog pipeline
GNEWS_API_KEY=

# ── Blog Pipeline ───────────────────────────────────────────────────────────
# [OPTIONAL] Toggle automated blog generation
BLOG_PIPELINE_ENABLED=false
BLOG_MAX_POSTS_PER_DAY=3
BLOG_AUTO_PUBLISH=false
BLOG_MIN_PRIORITY_SCORE=50

# ── Rate Limiting (Upstash Redis) ────────────────────────────────────────────
# [OPTIONAL] Upstash Redis for distributed rate limiting. Falls back to
# in-memory rate limiting if not set (fine for single-instance dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cron / Security ─────────────────────────────────────────────────────────
# [REQUIRED] Secret to authenticate cron job requests
CRON_SECRET=
# [REQUIRED] 32-byte hex key for encrypting settings. Generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=
# [REQUIRED] Server-side pepper for password hashing (HMAC pre-hash).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER share this value with NEXTAUTH_SECRET or any other key.
PASSWORD_PEPPER=

# ── App URLs ─────────────────────────────────────────────────────────────────
# [OPTIONAL] Public app URL (used in emails, OG images, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Tawk.to (Live Support Chat) ─────────────────────────────────────────────
# [OPTIONAL] Tawk.to Property ID - free plan: https://tawk.to
# Found in: Tawk.to dashboard -> Administration -> Property Settings
# The embed script URL format: https://embed.tawk.to/{PROPERTY_ID}/{WIDGET_ID}
NEXT_PUBLIC_TAWK_PROPERTY_ID=
# [OPTIONAL] Tawk.to Widget/Chat ID (the second segment in the embed URL)
# Defaults to 'default' when only one widget exists on the property.
NEXT_PUBLIC_TAWK_WIDGET_ID=default

# ─── Client IP resolution (docs/29 P1-5) ─────────────────────────────────────
# Rate limiting must not key on a client-forgeable header. On Vercel the default
# (xff + 1 trusted hop) is correct. The Cloudflare -> Fly cutover in docs/26
# REQUIRES both of these, or every rate limit becomes bypassable:
#   CLIENT_IP_SOURCE=cf
#   TRUSTED_PROXY_HOPS=2
CLIENT_IP_SOURCE=xff
TRUSTED_PROXY_HOPS=1

# ─── Unsubscribe token signing (docs/29 P1-6) ────────────────────────────────
# HMAC secret for campaign unsubscribe links. Falls back to
# NEWSLETTER_UNSUBSCRIBE_SECRET. Fails closed when neither is set, so campaign
# unsubscribe links stop working rather than accepting unsigned requests.
CAMPAIGN_UNSUBSCRIBE_SECRET=

# ─── Private document storage (docs/29 P0-1) ─────────────────────────────────
# Verification documents live in a PRIVATE bucket, served only via short-lived
# signed URLs. Create it in the Supabase dashboard with Public = OFF.
SUPABASE_PRIVATE_BUCKET=verification

# ─── AI transport bounds (docs/29 P1-12) ─────────────────────────────────────
AI_REQUEST_TIMEOUT_MS=60000

# ─── Bulk / newsletter mail compliance (CAN-SPAM 16 CFR 316) ─────────────────
# [REQUIRED for any bulk send] Physical postal address printed in the footer of
# every newsletter and bulk email. CAN-SPAM requires a valid physical postal
# address in commercial mail, so `cron/send-newsletter` SKIPS THE WHOLE RUN
# when this is unset — an unlawful send is worse than a missed one. A PO box
# or registered-agent address is acceptable; a fake one is not.
MAILING_POSTAL_ADDRESS=

# [OPTIONAL] Hard ceiling on recipients for one bulk email. A send resolving to
# more than this is rejected rather than truncated, so a mis-set filter cannot
# mail the whole user table. Default 5000 when unset.
BULK_EMAIL_MAX_RECIPIENTS=

# ─── Seed-donation simulation opt-in (docs/33) ───────────────────────────────
# `cron/simulate-donations` fabricates donation rows that are INDISTINGUISHABLE
# from real ones in public campaign totals. It refuses with 403 unless this is
# set to the exact sentinel below — the `simulation.enabled` admin setting is
# deliberately NOT sufficient, because a UI toggle is too cheap a way to start
# publishing fabricated money. Read docs/33 before setting it.
#   SEED_DONATIONS_OPT_IN=fabricated-donations-acknowledged
SEED_DONATIONS_OPT_IN=

# ─── Identity verification: Didit (docs/81) ──────────────────────────────────
# [OPTIONAL] Without it `POST /api/v1/verification/identity/session` answers
# 503 VERIFICATION_UNAVAILABLE rather than failing obscurely.
DIDIT_API_KEY=

# ─── SMS: Africa's Talking (docs/82, docs/84) ────────────────────────────────
# [OPTIONAL] Unset means no SMS is attempted at all.
#
# AT_USERNAME selects the environment, because that is how Africa's Talking
# models it and a key is scoped to one environment anyway:
#   sandbox          -> api.sandbox.africastalking.com, messages go to the
#                       SIMULATOR and never reach a handset
#   <your app name>  -> api.africastalking.com, real messages, real money
AT_USERNAME=
AT_API_KEY=
#
# [OPTIONAL] Registered short code or alphanumeric sender ID. Leave EMPTY
# unless one has been registered: an unregistered value does not error, it
# returns `InvalidSenderId` inside an HTTP 201 and sends nothing. Omitting it
# falls back to the shared sender Africa's Talking supplies.
AT_SENDER_ID=

# [OPTIONAL] ISO country used to read a phone number typed without a country
# code. Defaults to KE. See docs/82 — this is a product decision, not a knob.
SMS_DEFAULT_REGION=

# ─── Admin reporting timezone (docs/88 F15) ──────────────────────────────────
# [OPTIONAL] IANA zone used for every admin period boundary: "Today's
# donations", "This month", the 12-month revenue window. Defaults to UTC,
# which is what the server used implicitly before this was configurable.
#
# One zone for the whole business, not the viewer's: two admins in different
# countries must see the same number for "revenue this month" or the figure
# cannot be quoted to anyone. The admin screens print the zone next to the
# figures, so whatever is set here is visible to whoever reads them.
REPORTING_TIMEZONE=

# ─── Pool wedge watchdog (docs/87 amendment 6) ───────────────────────────────
# Terminates backends stuck in `active` + `wait_event = ClientRead` with a
# transaction open past the age below. That state has taken production down
# seven times and NOTHING IN POSTGRES BOUNDS IT: `statement_timeout` is not
# armed while waiting on client input, and `idle_in_transaction_session_timeout`
# only fires on `idle in transaction`.
#
# [OPTIONAL] `off` disables it entirely. `dry-run` logs what it would terminate
# and terminates nothing. Unset means ON, which is the intended setting.
DB_WATCHDOG=
# [OPTIONAL] Age floor in seconds, clamped to 60..86400. Default 300. A healthy
# request holds a transaction for milliseconds.
DB_WATCHDOG_MAX_TXN_AGE_SECONDS=
# [OPTIONAL] Sweep period in seconds, clamped to 10..3600. Default 60.
DB_WATCHDOG_INTERVAL_SECONDS=
